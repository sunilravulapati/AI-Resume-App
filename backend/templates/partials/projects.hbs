{{#if projects.length}}

% ── PROJECTS ──────────────────────────────────────────────────────────────────
\resumesection{Projects}
{{#each projects}}
\noindent\textbf{ {{this.title}} }
\vspace{2pt}
\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X >{\raggedleft\arraybackslash}p{2.8cm}@{}}
  {{#if this.tech}}{{../theme.designSystem.metaSize}}\textit{ {{this.tech}} }{{/if}} &
  {{../theme.designSystem.metaSize}} {{this.meta}} \\
\end{tabularx}
\vspace{3pt}
\begin{itemize}
{{#each this.bullets}}
  \item {{../theme.designSystem.bulletSize}} {{this}}
{{/each}}
\end{itemize}
{{#unless @last}}\vspace{ {{../theme.designSystem.itemSpacing}} }{{/unless}}
{{/each}}
{{/if}}

