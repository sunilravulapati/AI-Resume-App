{{#if projects.length}}

% ── PROJECTS ──────────────────────────────────────────────────────────────────
\section{Projects}
{{#each projects}}
\noindent\textbf{ {{this.title}} }{{#if this.tech}} $|$ \textit{\small {{this.tech}} }{{/if}} \hfill \small {{this.meta}}
\begin{itemize}
{{#each this.bullets}}
  \item \small {{this}}
{{/each}}
\end{itemize}
{{#unless @last}}\vspace{ {{../theme.designSystem.itemSpacing}} }{{/unless}}
{{/each}}
{{/if}}

{{#if awards.length}}

% ── AWARDS & ACHIEVEMENTS ─────────────────────────────────────────────────────
\section{Awards \& Achievements}
{{#each awards}}
\noindent\textbf{ {{this.title}} }{{#if this.date}} \hfill \small {{this.date}}{{/if}} \\
{{#if this.org}}\textit{\small {{this.org}} }{{/if}}{{#if this.desc}} --- \small {{this.desc}}{{/if}}
{{#unless @last}}\vspace{ {{../theme.designSystem.itemSpacing}} }{{/unless}}
{{/each}}
{{/if}}

{{#if certifications.length}}

% ── CERTIFICATIONS ────────────────────────────────────────────────────────────
\section{Certifications}
{{#each certifications}}
\noindent{{#if this.url}}\textbf{\href{ {{this.url}} }{ {{this.title}} }}{{else}}\textbf{ {{this.title}} }{{/if}}{{#if this.org}} --- \textit{\small {{this.org}} }{{/if}} \hfill \small {{this.dates}}
{{#unless @last}}\vspace{3pt}{{/unless}}
{{/each}}
{{/if}}

{{#if dsaProfiles.length}}

% ── DSA PROFICIENCY ───────────────────────────────────────────────────────────
\section{DSA Proficiency \& Competitive Programming}
