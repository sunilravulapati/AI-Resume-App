{{#each awards}}
\noindent\textbf{ {{this.title}} }
\vspace{2pt}
\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X >{\raggedleft\arraybackslash}p{2.8cm}@{}}
  {{#if this.org}}{{../theme.designSystem.metaSize}}\textit{ {{this.org}} }{{else}}\mbox{}}{{/if}} &
  {{#if this.date}}{{../theme.designSystem.metaSize}} {{this.date}}{{/if}} \\
\end{tabularx}
{{#if this.desc}}
\par\vspace{2pt}\noindent{{../theme.designSystem.metaSize}} {{this.desc}}
{{/if}}
{{#unless @last}}\vspace{ {{../theme.designSystem.itemSpacing}} }{{/unless}}
{{/each}}
{{/if}}

